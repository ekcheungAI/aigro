# AIGRO environment variables
# ─────────────────────────────────────────────────────────────
# NOT required for the current frontend-only build — the app runs on typed
# mock data + the committed AIHOT snapshot (src/data/aihot-snapshot.json).
# These placeholders are for the upcoming backend work (see docs/ROADMAP.md).
# Copy to .env.local and fill in when wiring the backend.

# --- Supabase (P0 live: auth magic-link, waitlist capture, conversation logging) ---
# Copy to .env.local for local dev. When set, the app uses REAL Supabase;
# when unset it gracefully falls back to localStorage demo mode (see docs/INTEGRATION.md).
# The anon/publishable key is public-by-design (RLS enforces access) and is safe
# to commit — the SERVICE key is server-only and must NEVER be in the client.
VITE_SUPABASE_URL=https://mxjgavuzzpcvazxdnuzg.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_pDAjZdCOEbhQ6_0Dlzy3Tg_AYQQmrOT
# Canonical redirect target for email, password reset, and social OAuth.
VITE_SITE_URL=https://aigro.io

# --- Firecrawl (Phase 3: expert material distillation pipeline) ---
# Server-side only — never expose in client bundles.
FIRECRAWL_API_KEY=fc-your-key

# --- AIHOT upstream (used by scripts/fetch-aihot.mjs) ---
# Public anonymous API, no key. A custom User-Agent is required and already
# set inside the script — browser UAs are blocked upstream.
AIHOT_BASE_URL=https://aihot.virxact.com

# --- MiniMax-M3 (Supabase Edge Function secrets; NEVER prefix with VITE_) ---
# Configure with `supabase secrets set ...`; do not put real values in this file.
MINIMAX_API_KEY=your-server-side-key
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
# Comma-separated browser origins allowed to call `ask-answer`.
ALLOWED_ORIGINS=https://aigro.io,https://www.aigro.io,https://aigro-blue.vercel.app,http://localhost:3000

# --- Distillation CMS (Supabase Edge Function secrets; server-side only) ---
OPENAI_API_KEY=your-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
YOUTUBE_TRANSCRIPT_API_KEY=your-youtube-transcript-key
YOUTUBE_TRANSCRIPT_BASE_URL=https://www.youtubetranscript.dev/api/v2
KNOWLEDGE_WORKER_SECRET=generate-a-long-random-secret

# --- Persona Compiler (internal Edge Function; server-side only) ---
PERSONA_COMPILER_SECRET=generate-a-separate-long-random-secret
# Optional overrides. Defaults to MINIMAX_MODEL when omitted.
MINIMAX_PERSONA_MODEL=MiniMax-M3
MINIMAX_PERSONA_EVALUATOR_MODEL=MiniMax-M3

# Firecrawl endpoints are configurable so provider API upgrades do not require
# application code changes.
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2

# Optional abuse protection. When configured, ask-answer verifies the token sent
# in x-turnstile-token. Leave blank only in local development.
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret
CHAT_RATE_LIMIT_PER_MINUTE=12

# --- Transactional email (Resend + Supabase Edge Functions; server-side only) ---
RESEND_API_KEY=your-resend-key
RESEND_FROM_EMAIL=AIGRO <booking@your-verified-domain.example>
RESEND_INVITE_FROM_EMAIL=AIGRO <invite@aigro.io>
RESEND_REPLY_TO=hello@aigro.io
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret
# Must match Supabase Auth → Email OTP Expiration.
INVITE_EXPIRY_HOURS=1
SITE_URL=https://aigro.io
BOOKING_WEBHOOK_SECRET=generate-another-long-random-secret

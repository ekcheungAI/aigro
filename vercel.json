{
  "headers": [
    {
      "source": "/design.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"aigro-design.md\"" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/insights", "destination": "/insights/index.html" },
    { "source": "/insights/daily", "destination": "/insights/daily/index.html" },
    { "source": "/cases", "destination": "/cases/index.html" },
    { "source": "/experts", "destination": "/experts/index.html" },
    { "source": "/guides", "destination": "/guides/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

{
  "headers": [
    {
      "source": "/design.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"aigro-design.md\"" }
      ]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}

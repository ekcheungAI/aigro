{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/design.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"aigro-design.md\"" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/insights", "destination": "/insights/index.html" },
    { "source": "/insights/daily", "destination": "/insights/daily/index.html" },
    { "source": "/cases", "destination": "/cases/index.html" },
    { "source": "/experts", "destination": "/experts/index.html" },
    { "source": "/guides", "destination": "/guides/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
